# ==============================================================================
# [환경 변수 설정 템플릿 - GitHub + Cloudflare Pages + R2 스택]
# 이 파일을 복사하여 `.env.local` 파일을 생성한 후 실제 값을 입력하세요.
# 주의: 이 파일(.env.example)은 Git에 공유되지만, 실제 비밀 키가 담긴 `.env.local`은 절대 Git에 올라가지 않습니다!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 프론트엔드 공개 환경 변수 (NEXT_PUBLIC_ 접두사 필수)
#    - 브라우저에 노출되어도 안전한 공개 주소 및 공개 키입니다.
# ------------------------------------------------------------------------------

# Cloudflare R2 공개 CDN 베이스 URL (커스텀 도메인 또는 r2.dev 공개 주소)
# 예: https://images.yourdomain.com 또는 https://pub-xxxxxx.r2.dev
NEXT_PUBLIC_CDN_BASE_URL=https://pub-xxxxxx.r2.dev

# Supabase 공개 접속 정보 (Anon Key는 RLS 보안 정책이 적용된 안전한 공개용 키입니다)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mapbox 지도 타일 토큰 (공개 토큰)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJleGFtcGxlIn0.xxxx


# ------------------------------------------------------------------------------
# 2. 백엔드/배치 전용 비밀 환경 변수 (절대 NEXT_PUBLIC_ 붙이지 말 것!)
#    - 프론트엔드 브라우저에 절대 노출되면 안 되는 민감한 비밀 키입니다.
# ------------------------------------------------------------------------------

# Supabase 관리자 마스터 키 (RLS 보안을 우회하므로 프론트에 노출 금지!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudflare R2 버킷 S3 호환 인증 자격 증명 (배치 스크립트 / Worker 전용)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=seoul-redevelopment-images
